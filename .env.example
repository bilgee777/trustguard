# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=trustguard
POSTGRES_DB=trustguard
# Choose a long random value. Avoid ';' and '=' because it is placed in a connection string.
POSTGRES_PASSWORD=

# --- API ---
# Signs session tokens. At least 32 characters; generate one:
#   PowerShell:  $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 48
JWT_SIGNING_KEY=

# Browsers only accept Secure cookies over HTTPS (localhost is the exception in Chrome and Firefox).
# Keep true for any real deployment; false only for plain-HTTP local use.
COOKIES_SECURE=false

# --- Ports (bound to 127.0.0.1 only) ---
WEB_PORT=8080
